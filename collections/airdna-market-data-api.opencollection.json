{
  "opencollection": "1.0.0",
  "info": {
    "name": "AirDNA Enterprise Market Data API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
